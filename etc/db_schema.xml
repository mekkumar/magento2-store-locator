<?xml version="1.0"?>
<schema
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
	<table name="kumar_storelocator_store" resource="default" engine="innodb"
           comment="Kumar Store Locator Stores">
		<column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true"/>
		<column xsi:type="varchar" name="name" nullable="false" length="255"/>
		<column xsi:type="varchar" name="code" nullable="false" length="64"/>
		<column xsi:type="smallint" name="status" nullable="false" default="1"/>
		<column xsi:type="varchar" name="logo" nullable="true" length="255"/>
		<column xsi:type="varchar" name="marker_icon" nullable="true" length="255"/>
		<column xsi:type="varchar" name="active_marker_icon" nullable="true" length="255"/>
		<column xsi:type="text" name="address" nullable="true"/>
		<column xsi:type="varchar" name="city" nullable="true" length="128"/>
		<column xsi:type="varchar" name="region" nullable="true" length="128"/>
		<column xsi:type="varchar" name="postcode" nullable="true" length="32"/>
		<column xsi:type="varchar" name="country_id" nullable="true" length="2"/>
		<column xsi:type="decimal" name="latitude" scale="8" precision="12" nullable="false" default="52.520008"/>
		<column xsi:type="decimal" name="longitude" scale="8" precision="12" nullable="false" default="13.404954"/>
		<column xsi:type="varchar" name="phone" nullable="true" length="64"/>
		<column xsi:type="varchar" name="email" nullable="true" length="255"/>
		<column xsi:type="varchar" name="website" nullable="true" length="255"/>
		<column xsi:type="text" name="description" nullable="true"/>
		<column xsi:type="text" name="opening_hours" nullable="true"/>
		<column xsi:type="text" name="services" nullable="true"/>
		<column xsi:type="decimal" name="rating" scale="2" precision="4" nullable="true"/>
		<column xsi:type="int" name="review_count" nullable="true"/>
		<column xsi:type="int" name="sort_order" nullable="false" default="0"/>
		<column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP"/>
		<column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true"/>
		<constraint xsi:type="primary" referenceId="PRIMARY">
			<column name="entity_id"/>
		</constraint>
		<constraint xsi:type="unique" referenceId="KUMAR_STORELOCATOR_CODE_UNQ">
			<column name="code"/>
		</constraint>
	</table>
</schema>
